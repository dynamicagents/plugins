{
  "name": "@dynamicagents/plugins",
  "version": "0.17.0",
  "description": "Optional, composable capabilities for a Dynamic Agent: browser rendering, a Linux container, git and pull requests on GitHub, a scratchpad, and Claude Code sessions. One subpath per plugin, so a bundle grows only with what it imports.",
  "keywords": [
    "ai-agents",
    "cloudflare-workers",
    "durable-objects",
    "agents-sdk",
    "browser-rendering",
    "containers",
    "git",
    "plugins"
  ],
  "license": "Apache-2.0",
  "author": "Dynamic Agents",
  "homepage": "https://github.com/dynamicagents/plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicagents/plugins.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicagents/plugins/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./repo-github": {
      "types": "./dist/repo-github/index.d.ts",
      "import": "./dist/repo-github/index.js"
    },
    "./scratch": {
      "types": "./dist/scratch/index.d.ts",
      "import": "./dist/scratch/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "import": "./dist/claude-code/index.js"
    },
    "./claude-code/daemon": {
      "types": "./dist/claude-code/daemon/index.d.ts",
      "import": "./dist/claude-code/daemon/index.js"
    },
    "./computer": {
      "types": "./dist/computer/index.d.ts",
      "import": "./dist/computer/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./sandbox/daemon": {
      "types": "./dist/sandbox/daemon/index.d.ts",
      "import": "./dist/sandbox/daemon/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "link:local": "node scripts/link-local.mjs",
    "types": "wrangler types --include-env=false",
    "types:check": "wrangler types --include-env=false --check && node scripts/verify-runtime-types.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "npm run verify:peer-ranges && npm run verify:references && npm run types:check && prettier --check . && eslint . && tsc && npm run build && npm run verify:exports",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:references": "node scripts/verify-references.mjs",
    "verify:peer-ranges": "node scripts/verify-peer-ranges.mjs",
    "probe:claude-code": "npm run build && node scripts/probe-claude-code.mjs",
    "probe:github-mcp": "node scripts/probe-github-mcp.mjs",
    "prepack": "npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check && npm test",
    "prepare": "husky || true && npm run build"
  },
  "peerDependencies": {
    "@cloudflare/computer": "^0.5.1",
    "@cloudflare/sandbox": "^1.0.1",
    "@cloudflare/think": ">=0.21.0 <0.22.0",
    "@dynamicagents/core": ">=0.17.0 <0.18.0",
    "agents": ">=0.30.0 <0.31.0",
    "ai": "^7.0.88",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@cloudflare/sandbox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/computer": "^0.5.1",
    "@cloudflare/sandbox": "^1.0.1",
    "@cloudflare/think": "^0.21.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@dynamicagents/core": "^0.17.1",
    "@types/node": "^26.5.1",
    "agents": "^0.30.1",
    "ai": "^7.0.101",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "workers-ai-provider": "^4.0.0",
    "wrangler": "^4.151.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "sharp": false,
    "workerd": false,
    "core-js-pure": false,
    "@mongodb-js/zstd": false
  }
}
