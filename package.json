{
  "name": "@dynamicagents/plugins",
  "version": "0.12.0",
  "description": "Optional, composable capabilities for a Dynamic Agent: ARC-AGI-3, browser rendering, a Linux container, git and pull requests, workspace, episodic recall, and pre-turn triage. One subpath per plugin, so a bundle grows only with what it imports.",
  "keywords": [
    "ai-agents",
    "cloudflare-workers",
    "durable-objects",
    "agents-sdk",
    "arc-agi",
    "vectorize",
    "browser-rendering",
    "containers",
    "git",
    "plugins"
  ],
  "license": "Apache-2.0",
  "author": "Dynamic Agents",
  "homepage": "https://github.com/dynamicagents/plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicagents/plugins.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicagents/plugins/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./arc-agi": {
      "types": "./dist/arc-agi/index.d.ts",
      "import": "./dist/arc-agi/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./recall": {
      "types": "./dist/recall/index.d.ts",
      "import": "./dist/recall/index.js"
    },
    "./triage": {
      "types": "./dist/triage/index.d.ts",
      "import": "./dist/triage/index.js"
    },
    "./repo": {
      "types": "./dist/repo/index.d.ts",
      "import": "./dist/repo/index.js"
    },
    "./scratch": {
      "types": "./dist/scratch/index.d.ts",
      "import": "./dist/scratch/index.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code/index.d.ts",
      "import": "./dist/claude-code/index.js"
    },
    "./computer": {
      "types": "./dist/computer/index.d.ts",
      "import": "./dist/computer/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "link:local": "node scripts/link-local.mjs",
    "types": "wrangler types --include-env=false",
    "types:check": "wrangler types --include-env=false --check && node scripts/verify-runtime-types.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "npm run verify:peer-ranges && npm run verify:references && npm run types:check && prettier --check . && eslint . && tsc && npm run build && npm run verify:exports",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:record": "RECORD=1 vitest run recorded.spec.ts",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:references": "node scripts/verify-references.mjs",
    "verify:peer-ranges": "node scripts/verify-peer-ranges.mjs",
    "prepack": "npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check && npm test",
    "prepare": "husky || true && npm run build"
  },
  "peerDependencies": {
    "@cloudflare/computer": "^0.3.1",
    "@cloudflare/shell": "^0.4.3",
    "@dynamicagents/core": ">=0.12.0 <0.13.0",
    "@platformatic/vfs": "^0.4.0",
    "agents": ">=0.24.0 <0.25.0",
    "ai": "^7.0.88",
    "drizzle-orm": ">=0.45.2",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@cloudflare/shell": {
      "optional": true
    },
    "@cloudflare/computer": {
      "optional": true
    },
    "@platformatic/vfs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/computer": "^0.3.1",
    "@cloudflare/shell": "0.4.3",
    "@platformatic/vfs": "^0.4.0",
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@dynamicagents/core": "git+https://github.com/dynamicagents/core.git#main",
    "@types/node": "^26.5.1",
    "agents": "^0.24.0",
    "ai": "^7.0.101",
    "drizzle-orm": ">=0.45.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "workers-ai-provider": "^4.0.0",
    "wrangler": "^4.131.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "github:dynamicagents/core": true,
    "esbuild": false,
    "fsevents": false,
    "sharp": false,
    "workerd": false,
    "core-js-pure": false,
    "@mongodb-js/zstd": false
  }
}
